# 依赖
node_modules/

# 构建产物
out/
dist/
# 任意自定义输出目录（electron-builder -c.directories.output=dist-xxx）
dist*/
coverage/

# 日志与临时文件
*.log
*.tmp

# git filter-branch 重写历史时的中间目录
.git-rewrite/

# 内部文档（PRD / 设计方案 / QA 报告 / 交付说明），不随源码公开
deliverables/

# 测试代码与调试截图，不随源码公开（保留在本机，不上传仓库）
tests/

# TypeScript 增量构建信息
*.tsbuildinfo

# 本机 OCR 引擎运行时下载的语言包副本（正式语言包在 resources/tessdata/）
/eng.traineddata

# 系统文件
Thumbs.db
.DS_Store

# 编辑器
.idea/
.vscode/
